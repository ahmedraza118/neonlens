# ─── Core ─────────────────────────────────────────────────────────────
# Public site URL (no trailing slash). Used for canonical URLs, sitemap, OG images, Stripe redirects.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Long random string: `openssl rand -hex 32`
PAYLOAD_SECRET=change-me

# Local: SQLite file. Production: Turso/libSQL URL, e.g. libsql://neonlens-you.turso.io
DATABASE_URL=file:./neonlens.db
DATABASE_AUTH_TOKEN=

# Production uploads (Vercel Blob). Leave empty to store uploads on local disk.
BLOB_READ_WRITE_TOKEN=

# Admin account created by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me

# ─── Lead notifications (all optional — logged to console when unset) ──
RESEND_API_KEY=
EMAIL_FROM="NeonLens Studio <hello@yourdomain.com>"
NOTIFY_EMAIL=you@yourdomain.com
# WhatsApp alerts via Twilio (sandbox works for testing)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
NOTIFY_WHATSAPP_TO=whatsapp:+40712345678

# ─── Payments (Stripe deposits) ───────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── SEO / analytics (optional) ───────────────────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_ID=

# ─── AI alt text (optional) — `npm run alt-text` ──────────────────────
ANTHROPIC_API_KEY=

# Password for the demo client gallery created by `npm run seed`
SEED_GALLERY_PASSWORD=change-me
