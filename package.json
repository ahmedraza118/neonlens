{
  "name": "neonlens",
  "version": "1.0.0",
  "description": "NeonLens — photo & videography studio website (Next.js + Payload CMS)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "vercel-build": "npm run migrate && npm run build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ./vitest.config.mts",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "alt-text": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/generate-alt-text.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@mux/mux-player-react": "3.14.0",
    "@payloadcms/db-sqlite": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-vercel-blob": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "cross-env": "10.1.0",
    "dotenv": "18.0.8",
    "graphql": "16.14.2",
    "next": "16.4.2",
    "payload": "3.91.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "resend": "6.34.1",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "stripe": "23.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "22.20.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  }
}
